  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@types/yup": "^0.32.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.15.3",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "uuid": "^13.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.0.2",
    "@vitest/eslint-plugin": "^1.3.23",
    "eslint": "^9.38.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.2"
  },
  "scripts": {
    "dev": "tsx --watch --env-file .env src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
